# Copy to .env and adjust. All values are optional.
PPTSVC_PORT=8000
PPTSVC_MAX_CONCURRENCY=2
PPTSVC_TIMEOUT_SECONDS=300

# Build-time mirrors. The compose defaults below match this network, where
# Docker Hub / deb.debian.org / cdn.playwright.dev are unreachable or flaky.
# On a healthy network, override back to the official sources:
#   BASE_IMAGE=node:20-bookworm-slim
#   DEBIAN_MIRROR=deb.debian.org
#   PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.playwright.dev
BASE_IMAGE=docker.1ms.run/library/node:20-bookworm-slim
DEBIAN_MIRROR=mirrors.tuna.tsinghua.edu.cn
PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
