# Host test path config. Loaded by tools/run-tests.ps1; PROBE_PLAYWRIGHT is
# also read by .probe scripts. Relative paths resolve against the
# pptx-site-theme root. Heavy binaries live in .test-runtime/ (gitignored).
PLAYWRIGHT_BROWSERS_PATH=.test-runtime/.pw-browsers
PROBE_PLAYWRIGHT=.test-runtime/node_modules/playwright
PPTSVC_E2E=1
